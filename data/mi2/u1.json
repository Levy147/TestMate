  "questions": [
    {"id":1,"type":"input","question":"Dado a=(1,0,3), b=(-1,3,0), calcule ||b-a||. Respuesta a 3 decimales.","correct":4.359,"answerType":"decimal","explanation":{"title":"Procedimiento","theory":"Vector v = b-a","steps":["v = (-2,3,-3)","||v|| = sqrt(4+9+9)=sqrt(22)"],"final":"4.359"}},
    {"id":2,"type":"input","question":"Para a=(1,0,3), b=(-1,3,0), calcule v1+v2+v3 donde v=b-a. Respuesta a 3 decimales.","correct":-2.000,"answerType":"decimal","explanation":{"title":"Procedimiento","theory":"Suma de componentes","steps":["v = (-2,3,-3)","-2+3-3=-2"],"final":"-2.000"}},
    {"id":3,"type":"input","question":"Sea L: x=(1,0,3)+t(-2,3,-3), z=(2,2,2). Calcule t̂=(w^T v)/(v^T v), w=z-a. Respuesta a 3 decimales.","correct":0.318,"answerType":"decimal","explanation":{"title":"Procedimiento","theory":"Proyección escalar","steps":["w=(1,2,-1)","w^T v = -2+6+3=7","v^T v=22","t̂=7/22=0.318"],"final":"0.318"}},
    {"id":4,"type":"input","question":"Con t̂=7/22, calcule la coordenada x de p=a+t̂ v. Respuesta a 3 decimales.","correct":0.364,"answerType":"decimal","explanation":{"title":"Procedimiento","theory":"p = a + t̂ v","steps":["p_x = 1 + (7/22)*(-2)=1-14/22=8/22=0.364"],"final":"0.364"}},
    {"id":5,"type":"input","question":"Calcule la distancia ||z-p|| con los datos anteriores. Respuesta a 3 decimales.","correct":1.944,"answerType":"decimal","explanation":{"title":"Procedimiento","theory":"Distancia = ||error||","steps":["e = z-p","||e|| = sqrt(...) ≈ 1.944"],"final":"1.944"}},
    {"id":6,"type":"input","question":"Distancia del punto (0,0,0) al plano x+y+z=1. Respuesta a 3 decimales.","correct":0.577,"answerType":"decimal","explanation":{"title":"Procedimiento","theory":"Fórmula distancia punto-plano","steps":["|0+0+0-1|/sqrt(1+1+1)=1/sqrt(3)"],"final":"0.577"}},
    {"id":7,"type":"input","question":"Distancia del punto (1,1,1) al plano x+y+z=3. Respuesta a 3 decimales.","correct":0.000,"answerType":"decimal","explanation":{"title":"Procedimiento","theory":"El punto pertenece al plano","steps":["1+1+1-3=0"],"final":"0.000"}},
    {"id":8,"type":"input","question":"Recta por origen v=(1,2,2), z=(3,0,0). t̂=(z^T v)/(v^T v). Respuesta a 3 decimales.","correct":0.333,"answerType":"decimal","explanation":{"title":"Procedimiento","theory":"Proyección","steps":["z^T v=3","v^T v=9","3/9=1/3"],"final":"0.333"}},
    {"id":9,"type":"input","question":"Con v=(1,2,2), ||v||. Respuesta a 3 decimales.","correct":3.000,"answerType":"decimal","explanation":{"title":"Procedimiento","theory":"Norma","steps":["sqrt(1+4+4)=3"],"final":"3.000"}},
